# Jev access. Leave empty to use MOCK mode (fake answers).
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
# Pin a version when tuning thresholds; jev-latest can move under you.
JEV_MODEL=jev-1.13.0

# PromptQL webhook (the "Run automatically" button). Copy both from your bot's webhook setup.
# Server-side only: never commit real values, never prefix with NEXT_PUBLIC_.
PROMPTQL_WEBHOOK_URL=
PROMPTQL_PAT=

# Optional: raises GitHub API limit while the app waits for results (60/hour without it).
GITHUB_TOKEN=
